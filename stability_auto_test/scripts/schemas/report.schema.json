{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stability_auto_test report v1.15",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "processes",
    "incidents",
    "issue_groups",
    "exit_info",
    "device_events",
    "resource_risk",
    "event_pipeline",
    "collection_health",
    "coverage_ratio",
    "verdict",
    "collectors",
    "policy",
    "recovery_warnings",
    "lifecycle_events",
    "bookmarks",
    "data_files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_mode": {
      "type": "string"
    },
    "run": {
      "type": "object",
      "required": [
        "started_at",
        "ended_at",
        "duration_sec",
        "exit_code",
        "exit_reason",
        "device",
        "package",
        "config_effective"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_sec": {
          "type": "number"
        },
        "exit_code": {
          "type": "integer"
        },
        "exit_reason": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recovered": {
          "type": "boolean"
        },
        "recovered_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase_timings": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "app_version_name": {
          "type": "string"
        },
        "app_version_code": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "device": {
          "type": "object"
        },
        "package": {
          "type": "string"
        },
        "config_effective": {
          "type": "object"
        }
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/process"
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/incident"
      }
    },
    "incident_summary": {
      "type": "object",
      "required": [
        "record_count",
        "root_problem_count",
        "correlated_termination_count",
        "by_type"
      ],
      "properties": {
        "record_count": {
          "type": "integer"
        },
        "root_problem_count": {
          "type": "integer"
        },
        "correlated_termination_count": {
          "type": "integer"
        },
        "by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "issue_groups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/issue_group"
      }
    },
    "exit_info": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/exit_info_record"
      }
    },
    "device_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_type",
          "started_at"
        ],
        "properties": {
          "event_type": {
            "type": "string"
          },
          "started_at": {
            "type": "number"
          },
          "ended_at": {
            "type": [
              "number",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "resource_risk": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pid",
          "ts",
          "metric",
          "value",
          "baseline",
          "message"
        ],
        "properties": {
          "pid": {
            "type": "integer"
          },
          "ts": {
            "type": "number"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "baseline": {
            "type": "number"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "event_pipeline": {
      "type": "object",
      "required": [
        "detected_count",
        "persisted_count",
        "failed_count",
        "timed_out_count",
        "dropped_by_cap_count",
        "dropped_by_backpressure_count"
      ],
      "properties": {
        "detected_count": {
          "type": "integer"
        },
        "persisted_count": {
          "type": "integer"
        },
        "failed_count": {
          "type": "integer"
        },
        "timed_out_count": {
          "type": "integer"
        },
        "dropped_by_cap_count": {
          "type": "integer"
        },
        "dropped_by_backpressure_count": {
          "type": "integer"
        }
      }
    },
    "collection_health": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "inconclusive"
      ]
    },
    "coverage_ratio": {
      "type": "number"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "stable",
        "unstable",
        "inconclusive"
      ]
    },
    "verdict_reason": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict_confidence": {
      "type": "string",
      "enum": [
        "high",
        "partial",
        "none"
      ]
    },
    "expected_exit_count": {
      "type": "integer"
    },
    "collectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "disk_audit": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "enabled",
        "passed",
        "rules"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/policy_rule"
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "sent": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "rate_limited": {
          "type": "integer"
        }
      }
    },
    "plugins": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "health": {
          "type": "object"
        },
        "outputs": {
          "type": "object"
        }
      }
    },
    "self_resource": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rss_growth_kb": {
          "type": "integer"
        },
        "rss_peak_kb": {
          "type": "integer"
        },
        "threads_peak": {
          "type": "integer"
        },
        "fds_peak": {
          "type": "integer"
        },
        "queue_peak": {
          "type": "integer"
        }
      }
    },
    "recovery_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle_events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/lifecycle_event"
      }
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/bookmark"
      }
    },
    "data_files": {
      "type": "object",
      "required": [
        "events",
        "lifecycle",
        "logcat",
        "journal"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logcat": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "process": {
      "type": "object",
      "required": [
        "name",
        "uptime_ratio",
        "restart_count",
        "events"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "first_seen_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "uptime_ratio": {
          "type": "number"
        },
        "restart_count": {
          "type": "integer"
        },
        "events": {
          "type": "object",
          "properties": {
            "java_crash": {
              "type": "integer"
            },
            "native_crash": {
              "type": "integer"
            },
            "anr": {
              "type": "integer"
            },
            "process_death": {
              "type": "integer"
            }
          }
        },
        "sample_failures": {
          "type": "object"
        }
      }
    },
    "incident": {
      "type": "object",
      "required": [
        "type",
        "process",
        "triggered_at",
        "severity",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "java_crash",
            "native_crash",
            "anr",
            "process_death"
          ]
        },
        "process": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "triggered_at": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "evidence_status": {
              "type": "string"
            },
            "error_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_match_confidence": {
              "type": "string"
            },
            "evidence_match_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "trace_verified": {
              "type": "boolean"
            },
            "trace_verify_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "context_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "pre_context_sec": {
              "type": "number"
            },
            "post_context_sec": {
              "type": "number"
            },
            "pre_context_sec_actual": {
              "type": "number"
            },
            "post_context_sec_actual": {
              "type": "number"
            },
            "pre_context_missing_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "post_context_missing_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "context_buffer_dropped_count": {
              "type": "integer"
            },
            "sampled": {
              "type": "boolean"
            },
            "sample_reason": {
              "type": "string"
            },
            "disk_quota_skipped": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "logcat_slice_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "trace_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "exception_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "signal": {
              "type": [
                "string",
                "null"
              ]
            },
            "fault_addr": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "top_frames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deobfuscated_frames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "symbolized_frames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "symbolication_status": {
              "type": "string"
            },
            "symbolication_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "diagnosis": {
              "type": "object",
              "required": [
                "category",
                "summary",
                "confidence"
              ],
              "properties": {
                "category": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "confidence": {
                  "type": "string"
                },
                "supporting_frames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "source": {
              "type": "string"
            },
            "dedup_count": {
              "type": "integer"
            },
            "fallback_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "device_ts": {
              "type": [
                "string",
                "null"
              ]
            },
            "dropbox_file": {
              "type": [
                "string",
                "null"
              ],
              "description": "Filename of matching dropbox entry body, or null if not found"
            },
            "secondary_to_incident_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "secondary_to_event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "root_cause_type": {
              "type": "string"
            },
            "root_cause_delay_sec": {
              "type": "number"
            },
            "termination_incident_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "termination_event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "termination_delay_sec": {
              "type": "number"
            }
          }
        }
      }
    },
    "exit_info_record": {
      "type": "object",
      "required": [
        "pid",
        "process",
        "timestamp",
        "exit_reason",
        "source",
        "confidence",
        "expected",
        "category",
        "is_stability_failure"
      ],
      "properties": {
        "pid": {
          "type": "integer"
        },
        "process": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "exit_reason": {
          "type": "string"
        },
        "exit_subreason": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "importance": {
          "type": "string"
        },
        "pss_kb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rss_kb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "expected": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "is_stability_failure": {
          "type": "boolean"
        },
        "correlated_incident_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "issue_group": {
      "type": "object",
      "required": [
        "fingerprint",
        "type",
        "occurrence_count",
        "first_seen_at",
        "last_seen_at",
        "affected_processes",
        "representative_incident_id",
        "occurrence_ids"
      ],
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "occurrence_count": {
          "type": "integer"
        },
        "first_seen_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "affected_processes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "representative_incident_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "occurrence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policy_rule": {
      "type": "object",
      "required": [
        "rule",
        "actual",
        "threshold",
        "pass"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "actual": {},
        "threshold": {},
        "pass": {
          "type": "boolean"
        }
      }
    },
    "lifecycle_event": {
      "type": "object",
      "required": [
        "timestamp",
        "process",
        "event"
      ],
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "new",
            "restart",
            "gone"
          ]
        },
        "old_pid": {
          "type": "integer"
        },
        "new_pid": {
          "type": "integer"
        },
        "gap_sec": {
          "type": "number"
        }
      }
    },
    "bookmark": {
      "type": "object",
      "required": [
        "timestamp",
        "label"
      ],
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
